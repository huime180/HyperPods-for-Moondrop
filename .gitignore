# 构建产物
*.iml
.gradle
/local.properties
/.idea
/build
/app/build
/captures
.externalNativeBuild
.cxx
.DS_Store

# 本地参考资料（上游仓库克隆）与设备日志，不随源码发布
/_refs/
/PuddingPods/
/_artifacts/
/out/

# Python
__pycache__/
*.pyc

# CI 诊断日志
/_ci_log*.txt
/_l*.txt

# 本地脚本（可能含凭据），绝不入库
/_*.sh
/_*.txt

# CI 产物（可随时从 Actions 重新下载）
/release/
/_shots/
/_scratch_bt/

# 签名材料：密钥库与本地签名属性绝不入库
# 正式签名的密钥库与口令放在仓库外（CI 用 GitHub Secrets，见 BUILD.md 第 7 节）
*.jks
*.keystore
*.p12
/keystore.properties
/signing.properties
