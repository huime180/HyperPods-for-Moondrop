<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        「机型图片」要访问 MOONDROP 的公开产品目录与图床
        （cdn-service.moondroplab.tech / cdn.moondroplab.tech）。仅此一处用网，
        不涉及任何账号或私有接口。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        连接弹窗要在应用**没有可见界面**时弹出（耳机连上时由 pods/BluetoothConnectReceiver.kt
        唤醒进程），而 Android 10 起禁止后台启动 Activity（BAL）。不依赖厂商 ROM 的豁免只有
        「显示在其他应用上层」（SYSTEM_ALERT_WINDOW）这一个，因此必须声明；
        HyperOS 上系统设置同一页里还有 MIUI 自己的「后台弹出界面」，两个都开才稳。
        这是特殊权限，只能在系统设置里由用户手动开启 —— 设置页提供了跳转入口。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperPodsMoondrop">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          快速弹窗：从通知点击 / 桌面图标进来只显示电量 + 降噪 + 快捷控制。
          半透明主题 + 卡片式布局，点卡片外或「关闭」退出。
          taskAffinity="" + excludeFromRecents="true" 与 OppoPods 的 PopupActivity 一致。

          这个 action 是 pods/PodNotification.kt 点击通知时的落点（它显式 setPackage，
          命中本应用自己的组件），因此 intent-filter 必须保留。
        -->
        <activity
            android:name=".ui.PopupActivity"
            android:theme="@style/Theme.HyperPodsMoondrop.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.show_popup" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          连接弹窗（ConnectionPopupActivity）：连上耳机时弹一次，显示设备名 + 三路电量后自动关闭。
          由 pods/ControlBridge.kt 以显式组件启动（推荐，不依赖 action）；也保留这条隐式 action，
          方便外部按 action 拉起：
            chen.action.hyperpods.moondrop.show_connection_popup
          extras：status 或 batteryParams（Bundle，电量编码）+ device_name + dismiss_seconds。
          复用 Popup 的半透明主题；taskAffinity="" + excludeFromRecents="true" 与 PopupActivity 一致。
        -->
        <activity
            android:name=".ui.ConnectionPopupActivity"
            android:theme="@style/Theme.HyperPodsMoondrop.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.show_connection_popup" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          应用侧「耳机连上就把本应用进程拉起来」（pods/BluetoothConnectReceiver.kt）。
          协议栈本来就在应用进程里（pods/MoondropLink.kt 自己 connectGatt / 建 RFCOMM），
          所以连耳机、读电量、发通知都不需要任何 hook；这条系统广播就是进程被唤醒的唯一入口。
          它监听系统蓝牙进程在 A2DP 连接状态变化时发出的**系统广播**
          （android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED，
          代码里的常量是 BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED），
          在 Android 8+ 的隐式广播豁免清单里，因此 manifest 静态注册也能收到。
          android:exported 按平台要求写 true：发送方是系统 / 蓝牙进程，不是本应用。
        -->
        <receiver
            android:name=".pods.BluetoothConnectReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
