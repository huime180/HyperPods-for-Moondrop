<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperPodsMoondrop">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.show_ui" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          快速弹窗（PuddingPods 的主入口形态）：从超级岛 / 设备卡 / 通知进来只显示
          电量 + 降噪 + 快捷控制。半透明主题 + 卡片式布局，点卡片外或「关闭」退出。
          taskAffinity="" + excludeFromRecents="true" 与 OppoPods 的 PopupActivity 一致。
        -->
        <activity
            android:name=".ui.PopupActivity"
            android:theme="@style/Theme.HyperPodsMoondrop.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.show_popup" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          连接弹窗（ConnectionPopupActivity）：连上耳机时弹一次，显示设备名 + 三路电量后自动关闭。
          由应用进程 / hook 启动，两种方式都行：
            · 显式组件：moe.chenxy.hyperpods.ui.ConnectionPopupActivity（推荐，不依赖 action）；
            · 隐式 action：chen.action.hyperpods.moondrop.show_connection_popup
              （字符串值见该 Activity 的 ACTION_SHOW_CONNECTION_POPUP 常量）。
          extras：status 或 batteryParams（Bundle，ControlBridge 的电量编码）+ device_name + dismiss_seconds。
          复用 Popup 的半透明主题；taskAffinity="" + excludeFromRecents="true" 与 PopupActivity 一致。
        -->
        <activity
            android:name=".ui.ConnectionPopupActivity"
            android:theme="@style/Theme.HyperPodsMoondrop.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection|smallestScreenSize|colorMode">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.show_connection_popup" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          应用侧跨进程控制桥（pods/ControlBridge.kt）。
          由 manifest 声明，因此系统各进程用显式广播即可唤醒本应用进程处理控制命令，
          不要求用户先打开本应用。显式广播（setPackage）不受 Android 8+ 隐式广播限制。
        -->
        <receiver
            android:name=".pods.ControlReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="chen.action.hyperpods.moondrop.pods_connected" />
                <action android:name="chen.action.hyperpods.moondrop.pods_disconnected" />
                <action android:name="chen.action.hyperpods.moondrop.ui_init" />
                <action android:name="chen.action.hyperpods.moondrop.request_battery" />
                <action android:name="chen.action.hyperpods.moondrop.request_capabilities" />
                <action android:name="chen.action.hyperpods.moondrop.anc_select" />
                <action android:name="chen.action.hyperpods.moondrop.gain_select" />
                <action android:name="chen.action.hyperpods.moondrop.led_select" />
                <action android:name="chen.action.hyperpods.moondrop.prompt_tone_select" />
                <action android:name="chen.action.hyperpods.moondrop.prompt_volume_select" />
                <action android:name="chen.action.hyperpods.moondrop.lhdc_select" />
                <action android:name="chen.action.hyperpods.moondrop.dual_connection_select" />
                <action android:name="chen.action.hyperpods.moondrop.low_latency_select" />
                <action android:name="chen.action.hyperpods.moondrop.gesture_select" />
                <action android:name="chen.action.hyperpods.moondrop.request_gesture" />
            </intent-filter>
        </receiver>

        <!-- LSPosed / libxposed 模块声明 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <!--
          LSPosed 共享首选项桥：设置页（ui/ModuleSettings.kt）写
          getSharedPreferences("hyperpods_moondrop_settings")，hook 侧
          （hook/XposedEntry.kt:117 的 getRemotePreferences("hyperpods_moondrop_settings")）读同一组。
          没有这条 meta-data，LSPosed 不会把模块首选项暴露给本应用进程，
          设置页写下的值就到不了 hook 进程（hook 侧会回落到默认值）。
        -->
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="MOONDROP (水月雨) 耳机 HyperOS 系统级控制" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
    </application>
</manifest>
